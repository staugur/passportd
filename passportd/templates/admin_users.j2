{% extends "layout.j2" %}
{% set admin_tab = 'users' %}
{% block title %}后台 · 用户管理 - {{ config.get("SITE_TITLE") or "Passport" }}{% endblock %}

{% block content %}
<section class="section">
    <div class="container" style="max-width: 1100px;">

        {% include "admin_tabs.j2" %}

        {# 搜索与筛选 #}
        <div class="box py-4 px-4 mb-4">
            <div class="field is-grouped is-grouped-multiline mb-0">
                <div class="control is-expanded" style="min-width: 220px;">
                    <input class="input is-small" type="text" id="search-input"
                           placeholder="按 uid、昵称或账号搜索">
                </div>
                <div class="control">
                    <div class="select is-small">
                        <select id="filter-status">
                            <option value="">全部状态</option>
                            <option value="1">正常</option>
                            <option value="0">已禁用</option>
                        </select>
                    </div>
                </div>
                <div class="control">
                    <div class="select is-small">
                        <select id="filter-role">
                            <option value="">全部角色</option>
                            <option value="superadmin">superadmin</option>
                            <option value="admin">admin</option>
                            <option value="user">user</option>
                        </select>
                    </div>
                </div>
                <div class="control">
                    <div class="select is-small">
                        <select id="filter-login-type">
                            <option value="">全部登录方式</option>
                            <option value="password">有密码</option>
                            <option value="third">仅第三方</option>
                            <option value="passkey">已绑定 Passkey</option>
                        </select>
                    </div>
                </div>
                <div class="control">
                    <div class="select is-small">
                        <select id="filter-order">
                            <option value="ctime">注册时间排序</option>
                            <option value="last_login">最后登录排序</option>
                        </select>
                    </div>
                </div>
                <div class="control">
                    <button class="button is-primary is-small" id="search-btn">
                        <span class="icon is-small"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <span>搜索</span>
                    </button>
                </div>
                <div class="control">
                    <button class="button is-light is-small" id="reset-btn">重置</button>
                </div>
                {% if g.is_superadmin %}
                <div class="control">
                    <button class="button is-link is-light is-small" id="export-btn">
                        <span class="icon is-small"><i class="fa-solid fa-file-csv"></i></span>
                        <span>导出 CSV</span>
                    </button>
                </div>
                {% endif %}
            </div>
            <div class="field is-grouped is-grouped-multiline mt-3 mb-0">
                <div class="control">
                    <label class="label is-small mb-1">注册时间起</label>
                    <input class="input is-small" type="date" id="filter-start">
                </div>
                <div class="control">
                    <label class="label is-small mb-1">注册时间止</label>
                    <input class="input is-small" type="date" id="filter-end">
                </div>
            </div>
        </div>

        <div id="error-notice" class="notification is-danger is-light is-hidden">
            <button class="delete"></button>
            <span id="error-msg"></span>
        </div>

        <div id="loading-notice" class="has-text-centered py-6 is-hidden">
            <span class="icon is-large has-text-grey-light"><i class="fa-solid fa-spinner fa-pulse fa-2x"></i></span>
            <p class="has-text-grey mt-2">加载中...</p>
        </div>

        <div id="user-list"></div>

        {# 分页（由 static/js/pager.js 渲染） #}
        <div id="pager" class="mt-5" style="display:none;"></div>

    </div>
</section>

{# 角色编辑模态框 #}
<div class="modal" id="role-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-user-gear"></i></span>
                    <span>管理用户角色</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
            <input type="hidden" id="role-uid" value="">
            <div class="is-flex is-align-items-center mb-4" style="gap:10px;">
                <span id="role-user-avatar"></span>
                <div>
                    <strong id="role-user-name"></strong>
                    <div class="has-text-grey is-size-7" id="role-user-uid"></div>
                    <div class="is-size-7 mt-1" id="role-user-meta"></div>
                </div>
            </div>

            <div class="field">
                <label class="label">平台角色</label>
                <div class="control">
                    <label class="checkbox mr-4">
                        <input type="checkbox" name="platform-role" value="superadmin"> superadmin
                    </label>
                    <label class="checkbox mr-4">
                        <input type="checkbox" name="platform-role" value="admin"> admin
                    </label>
                    <label class="checkbox">
                        <input type="checkbox" name="platform-role" value="user"> user
                    </label>
                </div>
                <p class="help">superadmin 可访问后台并执行高危操作；admin 为平台管理员角色；user 为普通用户。</p>
            </div>

            <div class="field" id="client-roles-field" style="display:none;">
                <label class="label">客户端角色</label>
                <div class="control">
                    <div class="tags" id="client-roles-tags"></div>
                </div>
                <p class="help">客户端角色由各 OIDC 应用分配，此处仅展示，修改平台角色时自动保留。</p>
            </div>
        </section>
        <footer class="modal-card-foot">
            <div class="buttons">
                <button type="button" class="button is-primary" id="save-role-btn">
                    <span class="icon"><i class="fa-solid fa-check"></i></span>
                    <span>保存</span>
                </button>
                <button type="button" class="button js-close-role-modal">取消</button>
            </div>
        </footer>
    </div>
</div>

{# 用户详情模态框 #}
<div class="modal" id="detail-modal">
    <div class="modal-background"></div>
    <div class="modal-card" style="width: 820px; max-width: 94vw;">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-address-card"></i></span>
                    <span>用户详情</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body" id="detail-body">
            <p class="has-text-grey is-size-7">加载中...</p>
        </section>
        <footer class="modal-card-foot">
            <button type="button" class="button js-close-detail-modal">关闭</button>
        </footer>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script src="{{ url_for('static', filename='js/pager.js') }}"></script>
<script>
    $(function () {
        let $listEl = $('#user-list');
        let $loadingEl = $('#loading-notice');
        let $errorEl = $('#error-notice');
        let $errorMsgEl = $('#error-msg');
        let $roleModal = $('#role-modal');
        let $detailModal = $('#detail-modal');
        let $pagerEl = $('#pager');
        let pageSize = 10;
        let currentPage = 1;

        // --- 通用 ---
        $errorEl.find('.delete').on('click', function () {
            $errorEl.addClass('is-hidden');
        });

        function showError(msg) {
            $errorMsgEl.text(msg);
            $errorEl.removeClass('is-hidden');
        }

        function escHtml(str) {
            return $('<div>').text(str === undefined || str === null ? '' : str).html();
        }

        function escAttr(str) {
            return escHtml(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function genderLabel(gender) {
            if (gender === 0) return '<span class="tag is-danger is-light is-size-7">女</span>';
            if (gender === 1) return '<span class="tag is-link is-light is-size-7">男</span>';
            return '<span class="has-text-grey-light">未知</span>';
        }

        function formatDate(ts) {
            if (!ts || ts <= 0) return '—';
            let d = new Date(ts * 1000);
            let yyyy = d.getFullYear();
            let mm = String(d.getMonth() + 1).padStart(2, '0');
            let dd = String(d.getDate()).padStart(2, '0');
            return yyyy + '-' + mm + '-' + dd;
        }

        function avatarHtml(avatar, nickname) {
            if (avatar) {
                return '<img src="' + escAttr(avatar) + '" alt="' + escAttr(nickname || '') + '"'
                    + ' style="width:32px;height:32px;border-radius:50%;object-fit:cover;flex:none;">';
            }
            return '<span style="width:32px;height:32px;border-radius:50%;background:#e5e7eb;color:#9ca3af;'
                + 'display:inline-flex;align-items:center;justify-content:center;flex:none;">'
                + '<i class="fa-solid fa-user"></i></span>';
        }

        function platformRoles(role) {
            return (role || '').split(' ').filter(function (r) {
                return r && r.indexOf(':') === -1;
            }).map(function (r) {
                return r.toLowerCase();
            });
        }

        function clientRoles(role) {
            return (role || '').split(' ').filter(function (r) {
                return r && r.indexOf(':') !== -1;
            });
        }

        function roleTag(role) {
            let cls = 'is-light';
            if (role === 'superadmin') cls = 'is-danger is-light';
            else if (role === 'admin') cls = 'is-warning is-light';
            else if (role === 'user') cls = 'is-info is-light';
            return '<span class="tag ' + cls + ' is-size-7">' + escHtml(role) + '</span>';
        }

        // --- 筛选参数与 URL 同步 ---
        function dateToTs(value, endOfDay) {
            if (!value) return '';
            let parts = value.split('-');
            if (parts.length !== 3) return '';
            let d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            if (endOfDay) d.setDate(d.getDate() + 1);
            return String(Math.floor(d.getTime() / 1000));
        }

        function collectFilters() {
            return {
                keyword: $('#search-input').val().trim(),
                status: $('#filter-status').val(),
                role: $('#filter-role').val(),
                login_type: $('#filter-login-type').val(),
                order: $('#filter-order').val(),
                start: dateToTs($('#filter-start').val(), false),
                end: dateToTs($('#filter-end').val(), true)
            };
        }

        function fillFiltersFromUrl() {
            let params = new URLSearchParams(window.location.search);
            if (params.get('keyword')) $('#search-input').val(params.get('keyword'));
            if (params.get('status')) $('#filter-status').val(params.get('status'));
            if (params.get('role')) $('#filter-role').val(params.get('role'));
            if (params.get('login_type')) $('#filter-login-type').val(params.get('login_type'));
            if (params.get('order')) $('#filter-order').val(params.get('order'));
            ['start', 'end'].forEach(function (key) {
                let ts = params.get(key);
                if (!ts) return;
                let d = new Date(Number(ts) * 1000);
                let value = d.getFullYear() + '-'
                    + String(d.getMonth() + 1).padStart(2, '0') + '-'
                    + String(d.getDate()).padStart(2, '0');
                $('#filter-' + key).val(value);
            });
        }

        function syncUrl(filters, page) {
            let params = {};
            Object.keys(filters).forEach(function (k) {
                if (filters[k]) params[k] = filters[k];
            });
            if (page && page > 1) params.page = page;
            let query = $.param(params);
            let url = window.location.pathname + (query ? '?' + query : '');
            window.history.replaceState(null, '', url);

        }

        // --- 加载用户列表 ---
        function loadUsers(page) {
            currentPage = page || 1;
            let filters = collectFilters();
            // 起始/结束是本地日期换算的时间戳，回填到 URL 时保持时间戳
            syncUrl(filters, currentPage);
            $loadingEl.removeClass('is-hidden');
            $errorEl.addClass('is-hidden');
            $listEl.empty();
            let data = $.extend({ page: currentPage, per_page: pageSize }, filters);
            $.ajax({
                url: '{{ url_for("root.api.admin_users") }}',
                method: 'GET',
                data: data,
                success: function (res) {
                    $loadingEl.addClass('is-hidden');
                    if (!res.success) {
                        showError(apiMessage(res, '加载失败'));
                        return;
                    }
                    let payload = res.data || {};
                    renderUsers(payload.users || []);
                    renderPager(payload);
                },
                error: function (xhr) {
                    $loadingEl.addClass('is-hidden');
                    showError('网络错误: ' + xhr.statusText);
                }
            });
        }

        function renderUsers(users) {
            if (!users.length) {
                $listEl.html('<div class="box has-text-centered has-text-grey py-6">'
                    + '<span class="icon is-large"><i class="fa-solid fa-user-slash fa-2x"></i></span>'
                    + '<p class="mt-3">没有匹配的用户</p></div>');
                return;
            }
            let html = '<div class="table-container"><table class="table is-fullwidth is-hoverable">'
                + '<thead><tr>'
                + '<th>用户</th>'
                + '<th>账号</th>'
                + '<th>平台角色</th>'
                + '<th>注册时间</th>'
                + '<th>最后登录</th>'
                + '<th>状态</th>'
                + '<th style="white-space: nowrap;">操作</th>'
                + '</tr></thead><tbody>';
            $.each(users, function (_, u) {
                let accounts = (u.accounts || []).map(function (a) {
                    return '<span class="tag is-light is-size-7 mr-1">' + escHtml(a.account) + '</span>';
                }).join('') || '<span class="has-text-grey-light">—</span>';
                let roles = platformRoles(u.role).map(roleTag).join(' ') || '<span class="has-text-grey-light">—</span>';
                let statusTag = (u.status === 0)
                    ? '<span class="tag is-danger is-light">已禁用</span>'
                    : '<span class="tag is-success is-light">正常</span>';
                let toggleLabel = (u.status === 0) ? '启用' : '禁用';
                let toggleCls = (u.status === 0) ? 'is-success' : 'is-danger';
                let userCell = '<div class="is-flex is-align-items-center" style="gap:8px;">'
                    + avatarHtml(u.avatar, u.nickname)
                    + '<div><div class="has-text-weight-semibold">' + escHtml(u.nickname || '—') + '</div>'
                    + '<code class="is-size-7 has-text-grey">' + escHtml(u.uid) + '</code></div></div>';
                let roleBtn = '';
                if ({{ 'true' if g.is_superadmin else 'false' }}) {
                    roleBtn = '<button class="button is-primary is-light js-role" data-uid="' + escAttr(u.uid) + '">'
                        + '<span class="icon is-small"><i class="fa-solid fa-user-gear"></i></span><span>角色</span></button>';
                }
                html += '<tr>'
                    + '<td>' + userCell + '</td>'
                    + '<td>' + accounts + '</td>'
                    + '<td>' + roles + '</td>'
                    + '<td class="is-size-7">' + formatDate(u.ctime) + '</td>'
                    + '<td class="is-size-7">' + formatDate(u.last_login) + '</td>'
                    + '<td>' + statusTag + '</td>'
                    + '<td style="white-space: nowrap;"><div class="buttons are-small is-flex-wrap-nowrap">'
                    + '<button class="button is-info is-light js-detail" data-uid="' + escAttr(u.uid) + '">'
                    + '<span class="icon is-small"><i class="fa-solid fa-address-card"></i></span><span>详情</span></button>'
                    + roleBtn
                    + '<button class="button ' + toggleCls + ' is-light js-toggle" data-uid="' + escAttr(u.uid) + '" data-status="' + u.status + '">'
                    + '<span class="icon is-small"><i class="fa-solid fa-power-off"></i></span><span>' + toggleLabel + '</span></button>'
                    + '</div></td></tr>';
            });
            html += '</tbody></table></div>';
            $listEl.html(html);
        }

        function renderPager(data) {
            let total = data.total || 0;
            if (total <= 0) {
                $pagerEl.hide().empty();
                return;
            }
            $pagerEl.show();
            PassportPager.render($pagerEl, {
                page: data.page || 1,
                pages: data.pages || 1,
                perPage: data.per_page || pageSize,
                total: total,
                onChange: function (page, perPage) {
                    pageSize = perPage;
                    loadUsers(page);
                }
            });
        }

        // --- 事件绑定 ---
        $('#search-btn').on('click', function () { loadUsers(1); });
        $('#search-input').on('keydown', function (e) {
            if (e.key === 'Enter') loadUsers(1);
        });
        $('#filter-status, #filter-role, #filter-login-type, #filter-order, #filter-start, #filter-end')
            .on('change', function () { loadUsers(1); });
        $('#reset-btn').on('click', function () {
            $('#search-input').val('');
            $('#filter-status, #filter-role, #filter-login-type').val('');
            $('#filter-order').val('ctime');
            $('#filter-start, #filter-end').val('');
            loadUsers(1);
        });
        $('#export-btn').on('click', function () {
            let filters = collectFilters();
            window.location.href = '{{ url_for("root.api.admin_users_export") }}'
                + '?' + $.param(filters);
        });

        // --- 用户详情 ---
        $listEl.on('click', '.js-detail', function () {
            let uid = $(this).data('uid');
            $('#detail-body').html('<p class="has-text-grey is-size-7">加载中...</p>');
            $detailModal.addClass('is-active');
            $.ajax({
                url: '{{ url_for("root.api.admin_user_detail_api") }}',
                method: 'GET',
                data: { uid: uid },
                success: function (res) {
                    if (!res.success) {
                        $('#detail-body').html('<p class="has-text-danger is-size-7">'
                            + escHtml(apiMessage(res, '加载失败')) + '</p>');
                        return;
                    }
                    renderDetail(res.data || {});
                },
                error: function () {
                    $('#detail-body').html('<p class="has-text-danger is-size-7">网络异常</p>');
                }
            });
        });

        function renderDetail(d) {
            let accounts = (d.accounts || []).map(function (a) {
                return '<span class="tag is-light is-size-7 mr-1">' + escHtml(a.account)
                    + ' <span class="has-text-grey">' + escHtml(a.classify) + '</span></span>';
            }).join('') || '<span class="has-text-grey-light">—</span>';
            let roles = platformRoles(d.role).map(roleTag).join(' ') || '—';
            let html = ''
                + '<div class="is-flex is-align-items-center mb-4" style="gap:12px;">'
                + avatarHtml(d.avatar, d.nickname)
                + '<div><p class="title is-6 mb-0">' + escHtml(d.nickname || '—') + '</p>'
                + '<code class="is-size-7 has-text-grey">' + escHtml(d.uid) + '</code></div>'
                + '<span style="margin-left:auto;">' + ((d.status === 0)
                    ? '<span class="tag is-danger is-light">已禁用</span>'
                    : '<span class="tag is-success is-light">正常</span>') + '</span>'
                + '</div>'
                + '<div class="columns is-multiline is-variable is-2 is-size-7">'
                + '<div class="column is-4"><strong>性别：</strong>' + genderLabel(d.gender) + '</div>'
                + '<div class="column is-4"><strong>地区：</strong>' + escHtml(d.location || '—') + '</div>'
                + '<div class="column is-4"><strong>密码：</strong>' + (d.has_password ? '已设置' : '未设置') + '</div>'
                + '<div class="column is-4"><strong>注册：</strong>' + formatDate(d.ctime) + '</div>'
                + '<div class="column is-4"><strong>平台角色：</strong>' + roles + '</div>'
                + '<div class="column is-4"><strong>Passkey：</strong>' + (d.passkey_count || 0) + ' 个</div>'
                + '<div class="column is-4"><strong>活跃会话：</strong>' + (d.active_session_count || 0) + '</div>'
                + '<div class="column is-4"><strong>OIDC 授权：</strong>' + (d.authorization_count || 0) + '</div>'
                + '<div class="column is-4"><strong>自建应用：</strong>' + (d.client_count || 0) + '</div>'
                + '<div class="column is-12"><strong>绑定账号：</strong>' + accounts + '</div>'
                + '</div>';

            // 最近登录
            html += '<h3 class="title is-6 mt-4 mb-2">最近登录</h3>';
            if ((d.recent_logins || []).length) {
                html += '<table class="table is-fullwidth is-narrow is-size-7"><thead><tr>'
                    + '<th>时间</th><th>方式</th><th>账号</th><th>IP</th><th>设备</th>'
                    + '</tr></thead><tbody>';
                d.recent_logins.forEach(function (r) {
                    let device = [r.browser, r.os].filter(Boolean).join(' / ') || '—';
                    html += '<tr><td>' + formatDate(r.ctime) + ' ' + clockOf(r.ctime) + '</td>'
                        + '<td>' + escHtml(r.method || '—') + '</td>'
                        + '<td>' + escHtml(r.account || '—') + '</td>'
                        + '<td>' + escHtml(r.ip || '—') + '</td>'
                        + '<td>' + escHtml(device) + '</td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<p class="has-text-grey is-size-7">暂无登录记录</p>';
            }

            // 最近审计
            html += '<h3 class="title is-6 mt-4 mb-2">最近审计</h3>';
            if ((d.recent_audits || []).length) {
                html += '<table class="table is-fullwidth is-narrow is-size-7"><thead><tr>'
                    + '<th>时间</th><th>操作</th><th>详情</th>'
                    + '</tr></thead><tbody>';
                d.recent_audits.forEach(function (r) {
                    let detailText = '';
                    try {
                        detailText = JSON.stringify(r.detail || {});
                    } catch (e) {
                        detailText = '';
                    }
                    if (detailText.length > 90) detailText = detailText.slice(0, 90) + '…';
                    html += '<tr><td>' + formatDate(r.ctime) + ' ' + clockOf(r.ctime) + '</td>'
                        + '<td>' + escHtml(r.action_label || r.action) + '</td>'
                        + '<td><code class="is-size-7">' + escHtml(detailText) + '</code></td></tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<p class="has-text-grey is-size-7">暂无审计记录</p>';
            }
            $('#detail-body').html(html);
        }

        function clockOf(ts) {
            if (!ts) return '';
            let d = new Date(ts * 1000);
            return String(d.getHours()).padStart(2, '0') + ':'
                + String(d.getMinutes()).padStart(2, '0');
        }

        $detailModal.find('.modal-background, .delete').on('click', function () {
            $detailModal.removeClass('is-active');
        });
        $('.js-close-detail-modal').on('click', function () {
            $detailModal.removeClass('is-active');
        });

        // --- 角色编辑 ---
        $listEl.on('click', '.js-role', function () {
            let uid = $(this).data('uid');
            $.ajax({
                url: '{{ url_for("root.api.admin_users") }}',
                method: 'GET',
                data: { keyword: uid, per_page: 1 },
                success: function (res) {
                    let users = (res.data && res.data.users) || [];
                    let user = null;
                    for (let i = 0; i < users.length; i++) {
                        if (users[i].uid === uid) { user = users[i]; break; }
                    }
                    if (user) openRoleModal(user);
                },
                error: function (xhr) {
                    alert('获取用户信息失败: ' + xhr.statusText);
                }
            });
        });

        function openRoleModal(user) {
            $('#role-uid').val(user.uid);
            $('#role-user-name').text(user.nickname || '—');
            $('#role-user-uid').text(user.uid);
            $('#role-user-avatar').html(avatarHtml(user.avatar, user.nickname));
            $('#role-user-meta').html(
                '性别：' + genderLabel(user.gender)
                + ' &nbsp;地区：' + escHtml(user.location || '—')
            );
            let plats = platformRoles(user.role);
            $('input[name="platform-role"]').each(function () {
                $(this).prop('checked', plats.indexOf($(this).val()) !== -1);
            });
            let cr = clientRoles(user.role);
            if (cr.length) {
                $('#client-roles-tags').html(cr.map(function (r) {
                    return '<span class="tag is-light is-size-7">' + escHtml(r) + '</span>';
                }).join(''));
                $('#client-roles-field').show();
            } else {
                $('#client-roles-field').hide();
            }
            $roleModal.addClass('is-active');
        }

        $roleModal.find('.modal-background, .delete').on('click', function () {
            $roleModal.removeClass('is-active');
        });
        $('.js-close-role-modal').on('click', function () {
            $roleModal.removeClass('is-active');
        });

        $('#save-role-btn').on('click', function () {
            let uid = $('#role-uid').val();
            if (!uid) return;
            let roles = $('input[name="platform-role"]:checked').map(function () {
                return $(this).val();
            }).get();
            let formData = new FormData();
            formData.append('uid', uid);
            formData.append('roles', roles.join(' '));
            $.ajax({
                url: '{{ url_for("root.api.admin_set_user_role") }}',
                method: 'PUT',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $roleModal.removeClass('is-active');
                        loadUsers(currentPage);
                    } else {
                        alert('保存失败: ' + apiMessage(res, '未知错误'));
                    }
                },
                error: function (xhr) {
                    alert('网络错误: ' + xhr.statusText);
                }
            });
        });

        // --- 启用/禁用 ---
        $listEl.on('click', '.js-toggle', function () {
            let uid = $(this).data('uid');
            let current = parseInt($(this).data('status'), 10);
            let next = current === 0 ? 1 : 0;
            if (next === 0 && !confirm('确定禁用该用户吗？禁用后该用户将无法登录。')) return;
            let formData = new FormData();
            formData.append('uid', uid);
            formData.append('status', String(next));
            $.ajax({
                url: '{{ url_for("root.api.admin_set_user_status") }}',
                method: 'PUT',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        loadUsers(currentPage);
                    } else {
                        alert('操作失败: ' + apiMessage(res, '未知错误'));
                    }
                },
                error: function (xhr) {
                    alert('网络错误: ' + xhr.statusText);
                }
            });
        });

        // 初始化：从 URL 恢复筛选条件
        fillFiltersFromUrl();
        loadUsers(1);
    });
</script>
{% endblock %}
