{% extends "layout.j2" %}
{% block title %}登录 - Passport{% endblock %}

{% block content %}
<div class="page-center">
  <div class="auth-card">
    <div class="card">
      <header class="card-header">
        <p class="card-header-title">登录 Passport</p>
      </header>
      <div class="card-content">
        {% if msg %}
          <div class="notification is-{{ msg_type }} is-light mb-4">
            <button class="delete"></button>
            {{ msg }}
          </div>
        {% endif %}

        {% if error %}
          <div class="notification is-danger is-light mb-4">
            <button class="delete"></button>
            {{ error }}
          </div>
        {% endif %}

        <!-- 登录方式切换 Tab -->
        <div class="tabs is-toggle is-fullwidth mb-4">
          <ul>
            <li class="is-active" id="tab-password" data-tab="password">
              <a>
                <span class="icon"><i class="fa-solid fa-lock"></i></span>
                <span>密码登录</span>
              </a>
            </li>
            <li id="tab-vcode" data-tab="vcode">
              <a>
                <span class="icon"><i class="fa-solid fa-message"></i></span>
                <span>验证码登录</span>
              </a>
            </li>
            {% if g.passkey_enabled %}
            <li id="tab-passkey" data-tab="passkey">
              <a>
                <span class="icon"><i class="fa-solid fa-fingerprint"></i></span>
                <span>Passkey 登录</span>
              </a>
            </li>
            {% endif %}
          </ul>
        </div>

        <!-- 密码登录表单 -->
        <div id="form-password" class="tab-content">
          <form method="post" action="{{ url }}">
            <input type="hidden" name="next" value="{{ next }}">

            <div class="field">
              <label class="label">账号</label>
              <div class="control has-icons-left">
                <input class="input" type="text" name="account"
                       placeholder="用户名 / 邮箱 / 手机号"
                       value="{{ account or '' }}" required autocomplete="username">
                <span class="icon is-small is-left">
                  <i class="fa-solid fa-user"></i>
                </span>
              </div>
            </div>

            <div class="field">
              <label class="label">密码</label>
              <div class="control has-icons-left">
                <input class="input" type="password" name="password"
                       placeholder="输入密码" required autocomplete="current-password">
                <span class="icon is-small is-left">
                  <i class="fa-solid fa-lock"></i>
                </span>
              </div>
            </div>

            <div class="field">
              <label class="checkbox">
                <input type="checkbox" name="remember" value="1">
                记住登录（7天有效）
              </label>
            </div>

            <div class="field mt-4">
              <button class="button is-primary is-fullwidth" type="submit">
                <strong>登 录</strong>
              </button>
            </div>

            <div class="has-text-right mt-2">
              <a class="is-size-7 has-text-grey" id="link-forgot-password" href="javascript:void(0)">
                忘记密码？
              </a>
            </div>
            <p class="help has-text-right is-size-7 has-text-grey" id="forgot-password-hint" style="display:none;">
              <i class="fa-solid fa-circle-info"></i>
              请使用「验证码登录」登录，然后前往个人中心修改密码
            </p>
          </form>
        </div>

        <!-- 验证码登录表单 -->
        <div id="form-vcode" class="tab-content is-hidden">
          <div class="field">
            <label class="label">账号</label>
            <div class="control has-icons-left">
              <input class="input" type="text" id="vcode-account"
                     placeholder="邮箱 / 手机号" required autocomplete="off">
              <span class="icon is-small is-left">
                <i class="fa-solid fa-user"></i>
              </span>
            </div>
            <p class="help">输入已注册的邮箱或手机号</p>
          </div>

          <div class="field is-grouped">
            <div class="control is-expanded">
              <label class="label">验证码</label>
              <input class="input" type="text" id="vcode-code"
                     placeholder="6 位数字验证码" maxlength="6"
                     required autocomplete="off">
            </div>
            <div class="control" style="padding-top: 2rem;">
              <button class="button is-primary is-outlined" id="btn-send-vcode"
                      type="button">
                <span>获取验证码</span>
              </button>
            </div>
          </div>

          <div class="field mt-4">
            <label class="checkbox">
              <input type="checkbox" id="vcode-remember">
              记住登录（7天有效）
            </label>
          </div>

          <div class="field">
            <button class="button is-primary is-fullwidth" id="btn-vcode-login"
                    type="button">
              <strong>登 录</strong>
            </button>
          </div>

          <p class="help has-text-grey mt-2 is-size-7" id="vcode-hint">
            验证码 5 分钟内有效，请勿泄露
          </p>
        </div>

        <!-- Passkey 登录表单 -->
        {% if g.passkey_enabled %}
        <div id="form-passkey" class="tab-content is-hidden">
          <div id="passkey-msg" class="notification is-danger is-light mb-3" style="display:none;">
            <button class="delete"></button>
            <span id="passkey-msg-text"></span>
          </div>
          <p class="has-text-centered mb-4 has-text-grey is-size-7">
            使用指纹、面部识别或设备 PIN 码快速登录
          </p>
          <div class="field">
            <button class="button is-primary is-fullwidth" id="btn-passkey-login" type="button">
              <span class="icon"><i class="fa-solid fa-fingerprint"></i></span>
              <strong>使用 Passkey 登录</strong>
            </button>
          </div>
          <p class="help has-text-centered mt-2 is-size-7 has-text-grey" id="passkey-hint">
            请确保当前设备已绑定 Passkey
          </p>
        </div>
        {% endif %}

        {% if oauth2_providers %}
          <div class="divider">
            <span>第三方登录</span>
          </div>

          <div class="field is-grouped is-flex-direction-column" style="gap: 0.75rem;">
            {% for pi in oauth2_providers %}
              <div class="control">
                <a class="button oauth-btn" href="{{ pi.endpoint }}"
                   {% if pi.bg %}style="background-color: {{ pi.bg }}; border-color: {{ pi.bg }}; color: #fff;"{% endif %}>
                  <span class="icon"><i class="{{ pi.icon }}"></i></span>
                  <span>使用 {{ pi.provider }} 登录</span>
                </a>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="has-text-centered mt-5">
          <p class="is-size-7 has-text-grey">
            还没有账号？
            <a href="{{ url_for('root.front.signup') }}" class="has-text-primary">立即注册</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
  $(function () {
    var $tabs = $('#tab-password, #tab-vcode, #tab-passkey');
    var $tabPassword = $('#tab-password');
    var $tabVcode = $('#tab-vcode');
    var $tabPasskey = $('#tab-passkey');
    var $formPassword = $('#form-password');
    var $formVcode = $('#form-vcode');
    var $formPasskey = $('#form-passkey');
    var $btnSend = $('#btn-send-vcode');
    var $btnLogin = $('#btn-vcode-login');
    var $btnPasskeyLogin = $('#btn-passkey-login');
    var $vcodeHint = $('#vcode-hint');
    var countdownTimer = null;

    // Tab 切换
    $('#tab-password a, #tab-vcode a, #tab-passkey a').on('click', function () {
      var tab = $(this).parent().data('tab');
      $tabs.removeClass('is-active');
      $formPassword.addClass('is-hidden');
      $formVcode.addClass('is-hidden');
      $formPasskey.addClass('is-hidden');
      $('#forgot-password-hint').hide();

      if (tab === 'password') {
        $tabPassword.addClass('is-active');
        $formPassword.removeClass('is-hidden');
      } else if (tab === 'vcode') {
        $tabVcode.addClass('is-active');
        $formVcode.removeClass('is-hidden');
      } else if (tab === 'passkey') {
        $tabPasskey.addClass('is-active');
        $formPasskey.removeClass('is-hidden');
      }
    });

    // 忘记密码 → 切换到验证码登录
    $('#link-forgot-password').on('click', function () {
      $tabVcode.addClass('is-active');
      $tabPassword.removeClass('is-active');
      $formVcode.removeClass('is-hidden');
      $formPassword.addClass('is-hidden');
      $('#vcode-account').focus();
      $('#forgot-password-hint').fadeIn();
      setTimeout(function () {
        $('#forgot-password-hint').fadeOut();
      }, 5000);
    });

    // 发送验证码
    $btnSend.on('click', function () {
      let account = $.trim($('#vcode-account').val());
      if (!account) {
        showNotification('请输入邮箱或手机号', 'danger');
        return;
      }

      $btnSend.prop('disabled', true).addClass('is-loading');

      $.ajax({
        url: '{{ url_for("root.api.send_login_vcode") }}',
        method: 'POST',
        data: { account: account },
        dataType: 'json',
        success: function (res) {
          if (res.success) {
            showNotification('验证码已发送，请注意查收', 'success');
            $btnSend.removeClass('is-loading');
            startCountdown(60);
          } else {
            showNotification(res.message || '发送失败', 'danger');
            $btnSend.prop('disabled', false).removeClass('is-loading');
          }
        },
        error: function () {
          showNotification('发送失败，请稍后重试', 'danger');
          $btnSend.prop('disabled', false).removeClass('is-loading');
        }
      });
    });

    // 验证码登录
    $btnLogin.on('click', function () {
      let account = $.trim($('#vcode-account').val());
      let code = $.trim($('#vcode-code').val());

      if (!account) {
        showNotification('请输入邮箱或手机号', 'danger');
        return;
      }
      if (!code || code.length !== 6) {
        showNotification('请输入 6 位验证码', 'danger');
        return;
      }

      $btnLogin.prop('disabled', true).addClass('is-loading');

      $.ajax({
        url: '{{ url_for("root.api.vcode_login") }}',
        method: 'POST',
        data: {
          account: account,
          code: code,
          remember: $('#vcode-remember').is(':checked') ? '1' : ''
        },
        dataType: 'json',
        success: function (res) {
          if (res.success) {
            let nextUrl = '{{ next }}' || '/';
            showNotification('登录成功，正在跳转…', 'success');
            setTimeout(function () {
              window.location.href = nextUrl;
            }, 500);
          } else {
            showNotification(res.message || '登录失败', 'danger');
            $btnLogin.prop('disabled', false).removeClass('is-loading');
          }
        },
        error: function () {
          showNotification('登录失败，请稍后重试', 'danger');
          $btnLogin.prop('disabled', false).removeClass('is-loading');
        }
      });
    });

    // 验证码倒计时 (seconds)
    function startCountdown(seconds) {
      let remaining = seconds;
      $btnSend.addClass('is-static');
      updateCountdownText();

      function updateCountdownText() {
        $btnSend.find('span').text(remaining + 's 后重发');
      }

      countdownTimer = setInterval(function () {
        remaining--;
        if (remaining <= 0) {
          clearInterval(countdownTimer);
          $btnSend.prop('disabled', false).removeClass('is-static');
          $btnSend.find('span').text('获取验证码');
        } else {
          updateCountdownText();
        }
      }, 1000);
    }

    // 显示通知提示
    function showNotification(message, type) {
      let cls = 'notification is-' + type + ' is-light mb-4';
      let $notification = $('<div class="' + cls + '"><button class="delete"></button>' + message + '</div>');
      // 移除已有通知，插入新通知
      $formVcode.find('.notification').remove();
      $notification.insertBefore('#form-vcode .field:first');
      // 6 秒后自动消失
      setTimeout(function () {
        $notification.fadeOut(300, function () { $(this).remove(); });
      }, 6000);
    }

    {% if g.passkey_enabled %}
    // ---- Passkey 登录 ----

    function b64urlToBuf(b64) {
      var bin = atob(b64.replace(/-/g, '+').replace(/_/g, '/'));
      var len = bin.length, buf = new ArrayBuffer(len), arr = new Uint8Array(buf);
      for (var i = 0; i < len; i++) arr[i] = bin.charCodeAt(i);
      return buf;
    }
    function bufToB64url(buf) {
      var arr = new Uint8Array(buf), bin = '';
      for (var i = 0; i < arr.byteLength; i++) bin += String.fromCharCode(arr[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Passkey 登录按钮
    $btnPasskeyLogin.on('click', function () {
      var $msg = $('#passkey-msg');
      var $msgText = $('#passkey-msg-text');
      $msg.hide();
      $btnPasskeyLogin.prop('disabled', true).addClass('is-loading');

      $.ajax({
        url: '{{ url_for("root.api.passkey_login_options") }}',
        method: 'POST',
        dataType: 'json',
        success: function (res) {
          if (!res.success || !res.data) {
            showPasskeyErr(res.message || '获取认证选项失败');
            return;
          }
          var opts = res.data;
          opts.challenge = b64urlToBuf(opts.challenge);
          if (opts.allowCredentials) {
            opts.allowCredentials = opts.allowCredentials.map(function (c) {
              c.id = b64urlToBuf(c.id);
              return c;
            });
          }
          navigator.credentials.get({ publicKey: opts }).then(function (cred) {
            var json = {
              id: cred.id,
              rawId: bufToB64url(cred.rawId),
              type: cred.type,
              response: {
                clientDataJSON: bufToB64url(cred.response.clientDataJSON),
                authenticatorData: bufToB64url(cred.response.authenticatorData),
                signature: bufToB64url(cred.response.signature)
              }
            };
            if (cred.response.userHandle) {
              json.response.userHandle = bufToB64url(cred.response.userHandle);
            }
            return $.ajax({
              url: '{{ url_for("root.api.passkey_login_verify") }}',
              method: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(json),
              dataType: 'json'
            });
          }).then(function (res) {
            if (res.success) {
              var token = res.data && res.data.token;
              if (token) {
                showNotification('登录成功，正在跳转…', 'success');
                var nextUrl = '{{ next }}' || '/';
                document.cookie = 'sid=' + token + ';path=/;max-age=7200;SameSite=Lax';
                setTimeout(function () { window.location.href = nextUrl; }, 500);
              }
            } else {
              showPasskeyErr(res.message || 'Passkey 验证失败');
            }
          }).catch(function (err) {
            if (err.name !== 'NotAllowedError') {
              showPasskeyErr('Passkey 认证失败：' + (err.message || '请重试'));
            }
            $btnPasskeyLogin.prop('disabled', false).removeClass('is-loading');
          });
        },
        error: function (xhr) {
          var msg = '服务请求失败';
          try { var r = JSON.parse(xhr.responseText); msg = r.message || msg; } catch (e) {}
          showPasskeyErr(msg);
        }
      });
    });

    function showPasskeyErr(msg) {
      $('#passkey-msg-text').text(msg);
      $('#passkey-msg').show();
      $btnPasskeyLogin.prop('disabled', false).removeClass('is-loading');
    }
    {% endif %}
  });
</script>
{% endblock %}
