{% extends "layout.j2" %}
{% block title %}Telegram 登录 - Passport{% endblock %}

{% block content %}
<div class="page-center">
    <div class="auth-card">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">
                    <span class="icon"><i class="fa-brands fa-telegram"></i></span>
                    <span>Telegram 登录</span>
                </p>
            </header>
            <div class="card-content">
                <p class="has-text-centered has-text-grey is-size-7 mb-4">
                    点击下方按钮，在 Telegram 中完成授权后自动登录
                </p>

                {% if bot_username %}
                <div class="has-text-centered">
                    <script async src="https://telegram.org/js/telegram-widget.js?22"
                            data-telegram-login="{{ bot_username }}"
                            data-auth-url="{{ auth_url }}"
                            data-size="large"></script>
                </div>

                <p class="has-text-centered has-text-grey is-size-7 mt-4">
                    若按钮未显示，请确认本站点为 HTTPS 且 Bot 已在 @BotFather 配置域名
                </p>
                {% else %}
                <div class="notification is-danger is-light has-text-centered">
                    Telegram 登录暂不可用：请确认已配置
                    <code>TELEGRAM_BOT_TOKEN</code>，且服务器可访问 Telegram API
                    或已配置 <code>TELEGRAM_API_PROXY</code> 代理。
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
