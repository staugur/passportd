{% extends "layout.j2" %}
{% block title %}个人主页 - Passport{% endblock %}

{% block content %}
<section class="section">
    <div class="container" style="max-width: 800px;">
        {# 绑定/操作结果消息 #}
        {% if msg %}
        <div class="notification is-{{ msg_type }} is-light">
            <button class="delete"></button>
            {{ msg }}
        </div>
        {% endif %}

        {# 用户信息卡片 #}
        <div class="box">
            <div class="media">
                <figure class="media-left">
                    <p class="image is-96x96">
                        {% if profile.avatar %}
                        <img class="profile-avatar" src="{{ profile.avatar }}" alt="avatar">
                        {% else %}
                        <span class="icon is-large has-text-grey-light" style="width: 96px; height: 96px;">
                            <i class="fa-solid fa-circle-user" style="font-size: 96px;"></i>
                        </span>
                        {% endif %}
                    </p>
                </figure>
                <div class="media-content">
                    <div class="content">
                        <div class="is-flex is-align-items-center mb-1" style="gap: 0.75rem;">
                            <p class="title is-4 mb-0">
                                {{ profile.nickname or profile.uid[:8] }}
                            </p>
                            <button class="button is-small is-primary is-light js-open-edit">
                                <span class="icon is-small"><i class="fa-solid fa-pen-to-square"></i></span>
                                <span>编辑资料</span>
                            </button>
                            <button class="button is-small is-primary is-light js-open-change-pwd">
                                <span class="icon is-small"><i class="fa-solid fa-key"></i></span>
                                <span>修改密码</span>
                            </button>
                        </div>
                        <p class="subtitle is-6 has-text-grey mb-2">
                            @{{ profile.uid }}
                        </p>
                        {% if profile.bio %}
                        <p class="mb-2">{{ profile.bio }}</p>
                        {% endif %}
                        <div class="tags">
                            {% if profile.gender == 1 %}
                            <span class="tag is-link is-light"><i class="fa-solid fa-mars mr-1"></i>男</span>
                            {% elif profile.gender == 0 %}
                            <span class="tag is-danger is-light"><i class="fa-solid fa-venus mr-1"></i>女</span>
                            {% endif %}
                            {% if profile.location %}
                            <span class="tag is-info is-light"><i class="fa-solid fa-location-dot mr-1"></i>{{
                                profile.location }}</span>
                            {% endif %}
                            {% if profile.role %}
                            {% for r in profile.role.split(' ') %}
                            <span class="tag is-success is-light">{{ r }}</span>
                            {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# 基本信息 #}
        <div class="box">
            <h2 class="title is-5 mb-4">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-circle-info"></i></span>
                    <span>基本信息</span>
                </span>
            </h2>
            <div class="columns is-multiline is-mobile">
                <div class="column is-half-mobile is-one-third-tablet">
                    <p class="heading has-text-grey">用户 ID</p>
                    <p class="is-size-7 is-family-monospace">{{ profile.uid }}</p>
                </div>
                <div class="column is-half-mobile is-one-third-tablet">
                    <p class="heading has-text-grey">状态</p>
                    <p>
                        {% if profile.status == 1 %}
                        <span class="tag is-success is-light">正常</span>
                        {% else %}
                        <span class="tag is-danger is-light">禁用</span>
                        {% endif %}
                    </p>
                </div>
                <div class="column is-half-mobile is-one-third-tablet">
                    <p class="heading has-text-grey">注册时间</p>
                    {% if profile.ctime %}
                    <p class="is-size-7 js-timestamp" data-ts="{{ profile.ctime }}"></p>
                    {% else %}
                    <p class="has-text-grey-light is-size-7">—</p>
                    {% endif %}
                </div>
                <div class="column is-half-mobile is-one-third-tablet">
                    <p class="heading has-text-grey">最后更新</p>
                    {% if profile.mtime %}
                    <p class="is-size-7 js-timestamp" data-ts="{{ profile.mtime }}"></p>
                    {% else %}
                    <p class="has-text-grey-light is-size-7">—</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# 绑定账号列表 #}
        <div class="box">
            <h2 class="title is-5 mb-4">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-link"></i></span>
                    <span>绑定账号</span>
                </span>
                <span class="ml-3">
                    <button class="button is-small is-success is-light js-open-bind" data-action="bind">
                        <span class="icon is-small"><i class="fa-solid fa-plus"></i></span>
                        <span>绑定</span>
                    </button>
                </span>
            </h2>
            {% if accounts %}
            <div class="table-container" id="accounts-table">
                <table class="table is-fullwidth is-hoverable">
                    <thead>
                        <tr>
                            <th>账号</th>
                            <th>类型</th>
                            <th>绑定时间</th>
                            <th style="width: 80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for acct in accounts %}
                        <tr data-account="{{ acct.account }}" data-classify="{{ acct.classify }}">
                            <td>
                                <span class="is-size-7 is-family-monospace">{{ acct.account }}</span>
                            </td>
                            <td>
                                {% if acct.classify == 'username' %}
                                <span class="tag is-info is-light">用户名</span>
                                {% elif acct.classify == 'email' %}
                                <span class="tag is-warning is-light">邮箱</span>
                                {% elif acct.classify == 'mobile' %}
                                <span class="tag is-link is-light">手机号</span>
                                {% elif acct.classify == '3rd' %}
                                <span class="tag is-success is-light">第三方</span>
                                {% else %}
                                <span class="tag is-light">{{ acct.classify }}</span>
                                {% endif %}
                            </td>
                            <td class="is-size-7 js-timestamp" data-ts="{{ acct.ctime }}"></td>
                            <td>
                                {% if acct.classify in ('email', 'mobile') and not loop.first %}
                                <button class="button is-danger is-light is-small js-open-unbind" data-account="{{ acct.account }}">
                                    <span>解绑</span>
                                </button>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="has-text-centered has-text-grey py-4">
                <span class="icon is-large"><i class="fa-solid fa-circle-exclamation"></i></span>
                <p>暂无绑定的账号信息</p>
            </div>
            {% endif %}
        </div>

        {# 登录历史 #}
        <div class="box">
            <h2 class="title is-5 mb-4">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-clock-rotate-left"></i></span>
                    <span>最近登录</span>
                </span>
            </h2>
            {% if login_records %}
            <div class="table-container">
                <table class="table is-fullwidth is-hoverable">
                    <thead>
                        <tr>
                            <th>时间</th>
                            <th>方式</th>
                            <th>IP</th>
                            <th>地点</th>
                            <th>设备</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rec in login_records %}
                        <tr>
                            <td class="is-size-7 js-timestamp" data-ts="{{ rec.ctime }}"></td>
                            <td>
                                {% if rec.method == 'local' %}
                                <span class="tag is-info is-light">账号密码</span>
                                {% else %}
                                <span class="tag is-light">{{ rec.method }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="is-size-7 is-family-monospace">{{ rec.ip or '—' }}</span>
                            </td>
                            <td>
                                <span class="is-size-7">{{ rec.location or '—' }}</span>
                            </td>
                            <td>
                                <span class="is-size-7" title="{{ rec.user_agent or '' }}">
                                    {{ rec.browser or '' }} {{ rec.os or '' }}
                                    {% if rec.device == 'Mobile' %}
                                    <span class="tag is-warning is-light is-small ml-1">手机</span>
                                    {% elif rec.device == 'Tablet' %}
                                    <span class="tag is-link is-light is-small ml-1">平板</span>
                                    {% endif %}
                                </span>
                                {% if not rec.browser and not rec.os %}
                                <span class="has-text-grey-light is-size-7">—</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="has-text-centered has-text-grey py-4">
                <span class="icon is-large"><i class="fa-solid fa-clock"></i></span>
                <p>暂无登录记录</p>
            </div>
            {% endif %}
        </div>

        {# 绑定第三方登录 #}
        <div class="box">
            <h2 class="title is-5 mb-4">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-plug"></i></span>
                    <span>绑定第三方登录</span>
                </span>
            </h2>
            {% if oauth2_providers %}
            <p class="mb-3 has-text-grey is-size-7">绑定第三方账号后，可使用该平台账号快捷登录</p>
            <div class="buttons">
                {% for prov in oauth2_providers %}
                <a href="{{ prov.endpoint }}" class="button {{ prov.color or 'is-light' }}">
                    <span class="icon">
                        <i class="{{ prov.icon }}"></i>
                    </span>
                    <span>{{ prov.provider }}</span>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <p class="has-text-grey is-size-7">暂无可用的第三方登录提供商</p>
            {% endif %}
        </div>

        {# Passkey 管理 #}
        {% if g.passkey_enabled %}
        <div class="box" id="passkey-section">
            <h2 class="title is-5 mb-4">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-fingerprint"></i></span>
                    <span>Passkey 管理</span>
                </span>
                <span class="ml-3">
                    <button class="button is-small is-success is-light" id="btn-add-passkey">
                        <span class="icon is-small"><i class="fa-solid fa-plus"></i></span>
                        <span>绑定 Passkey</span>
                    </button>
                </span>
            </h2>
            <p class="mb-3 has-text-grey is-size-7">绑定 Passkey 后，可使用指纹、面部识别或设备 PIN 码快速登录。</p>
            <div id="passkey-msg" class="mb-3" style="display:none;"></div>
            <div class="table-container">
                <table class="table is-fullwidth is-hoverable" id="passkey-table">
                    <thead>
                        <tr>
                            <th>设备名称</th>
                            <th>绑定时间</th>
                            <th>最近使用</th>
                            <th style="width:80px;">操作</th>
                        </tr>
                    </thead>
                    <tbody id="passkey-tbody">
                        <tr id="passkey-empty-row">
                            <td colspan="4" class="has-text-centered has-text-grey">暂无绑定的 Passkey 设备</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}


    </div>
</section>

{# 绑定 / 解绑验证码模态框 #}
<div class="modal" id="account-vcode-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i id="vcode-modal-icon" class="fa-solid fa-plus"></i></span>
                    <span id="vcode-modal-title">绑定邮箱 / 手机号</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
            <div id="vcode-msg" class="mb-3" style="display:none;"></div>
            {# 绑定：步骤1-填写账号；解绑：直接显示待解绑账号+密码输入 #}
            <div id="vcode-step-account">
                <div class="field">
                    <label class="label" id="vcode-account-label">邮箱 / 手机号</label>
                    <div class="control">
                        <input class="input" type="text" id="vcode-account-input" placeholder="请输入邮箱或手机号" maxlength="128">
                    </div>
                </div>
                <div class="field" id="vcode-pwd-row" style="display:none;">
                    <label class="label">当前密码</label>
                    <div class="control">
                        <input class="input" type="password" id="vcode-pwd-input" placeholder="输入当前密码确认解绑" maxlength="128" autocomplete="current-password">
                    </div>
                </div>
                <div class="field">
                    <button class="button is-primary" id="vcode-send-btn">
                        <span>获取验证码</span>
                    </button>
                    <span class="has-text-grey is-size-7 ml-2" id="vcode-send-tip"></span>
                </div>
            </div>
            {# 绑定：步骤2-填写验证码 #}
            <div id="vcode-step-code" style="display:none;">
                <p class="mb-2 has-text-grey is-size-7" id="vcode-sent-to">验证码已发送至 </p>
                <div class="field">
                    <label class="label">验证码</label>
                    <div class="control">
                        <input class="input" type="text" id="vcode-input" placeholder="请输入 6 位数字验证码" maxlength="6" inputmode="numeric">
                    </div>
                </div>
                <div class="field">
                    <button class="button is-primary" id="vcode-confirm-btn">
                        <span>确认</span>
                    </button>
                    <button class="button is-light ml-2" id="vcode-resend-btn" disabled>
                        <span id="vcode-resend-text">重新发送</span>
                    </button>
                    <button class="button is-text ml-2" id="vcode-back-btn">
                        <span>更换账号</span>
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

{# 编辑资料模态框 #}
<div class="modal" id="edit-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                    <span>编辑个人资料</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <form method="POST" action="{{ url_for('root.front.profile') }}">
            <section class="modal-card-body">
                {# 昵称 #}
                <div class="field">
                    <label class="label">昵称</label>
                    <div class="control">
                        <input class="input" type="text" name="nickname" value="{{ profile.nickname or '' }}"
                            placeholder="输入昵称" maxlength="64">
                    </div>
                </div>

                {# 简介 #}
                <div class="field">
                    <label class="label">简介</label>
                    <div class="control">
                        <textarea class="textarea" name="bio" rows="3" placeholder="简单介绍自己"
                            maxlength="500">{{ profile.bio or '' }}</textarea>
                    </div>
                </div>

                {# 性别 #}
                <div class="field">
                    <label class="label">性别</label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select name="gender">
                                <option value="2" {% if profile.gender==2 %}selected{% endif %}>保密</option>
                                <option value="1" {% if profile.gender==1 %}selected{% endif %}>男</option>
                                <option value="0" {% if profile.gender==0 %}selected{% endif %}>女</option>
                            </select>
                        </div>
                    </div>
                </div>

                {# 地区 #}
                <div class="field">
                    <label class="label">地区</label>
                    <div class="control">
                        <input class="input" type="text" name="location" value="{{ profile.location or '' }}"
                            placeholder="例如：北京" maxlength="64">
                    </div>
                </div>

                {# 头像 #}
                <div class="field">
                    <label class="label">头像</label>
                    <div class="control">
                        <div class="columns is-vcentered is-mobile mb-2">
                            <div class="column is-narrow">
                                <figure class="image is-64x64" style="border-radius:50%;overflow:hidden;border:2px solid #e5e7eb;" id="edit-avatar-preview-wrap">
                                    <img id="edit-avatar-preview" src="{{ profile.avatar or '' }}" alt="" style="object-fit:cover;width:100%;height:100%;" onerror="this.style.display='none';">
                                    <span class="icon is-large has-text-grey-lighter" id="edit-avatar-placeholder" style="display:{{ 'none' if profile.avatar else 'flex' }};align-items:center;justify-content:center;width:64px;height:64px;"><i class="fa-solid fa-user fa-2x"></i></span>
                                </figure>
                            </div>
                            <div class="column">
                                <button type="button" class="button is-small is-light" id="btn-upload-avatar">
                                    <span class="icon"><i class="fa-solid fa-upload"></i></span>
                                    <span>上传头像</span>
                                </button>
                                <button type="button" class="button is-small is-light is-danger ml-2" id="btn-clear-avatar" title="清除头像" style="display:{{ 'inline-flex' if profile.avatar else 'none' }};">
                                    <span class="icon"><i class="fa-solid fa-xmark"></i></span>
                                </button>
                            </div>
                        </div>
                        <input type="hidden" name="avatar" id="edit-avatar-url" value="{{ profile.avatar or '' }}">
                        <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/gif,image/webp" style="display:none;">
                    </div>
                </div>
            </section>
            <footer class="modal-card-foot">
                <div class="buttons">
                    <button type="submit" class="button is-primary">
                        <span class="icon"><i class="fa-solid fa-check"></i></span>
                        <span>保存修改</span>
                    </button>
                    <button type="button" class="button js-close-edit">取消</button>
                </div>
            </footer>
        </form>
    </div>
</div>

{# 头像裁剪模态框 #}
<div class="modal" id="crop-modal">
    <div class="modal-background"></div>
    <div class="modal-card" style="max-width: 520px;">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-crop-simple"></i></span>
                    <span>裁剪头像</span>
                </span>
            </p>
            <button class="delete" aria-label="close" id="btn-close-crop"></button>
        </header>
        <section class="modal-card-body">
            <div style="max-height:400px;">
                <img id="crop-image" style="display:block;max-width:100%;">
            </div>
        </section>
        <footer class="modal-card-foot">
            <div class="buttons">
                <button type="button" class="button is-primary" id="btn-crop-confirm">
                    <span class="icon"><i class="fa-solid fa-check"></i></span>
                    <span>确认裁剪</span>
                </button>
                <button type="button" class="button" id="btn-crop-cancel">取消</button>
            </div>
        </footer>
    </div>
</div>

{# 修改密码模态框 #}
<div class="modal" id="change-pwd-modal">
    <div class="modal-background"></div>
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">
                <span class="icon-text">
                    <span class="icon"><i class="fa-solid fa-key"></i></span>
                    <span>修改密码</span>
                </span>
            </p>
            <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
            <div id="change-pwd-msg" class="mb-3" style="display:none;"></div>
            <div class="field">
                <label class="label">新密码</label>
                <div class="control has-icons-left">
                    <input class="input" type="password" id="new-password" placeholder="输入新密码（6-32位）">
                    <span class="icon is-small is-left"><i class="fa-solid fa-lock"></i></span>
                </div>
            </div>
            <div class="field">
                <label class="label">确认新密码</label>
                <div class="control has-icons-left">
                    <input class="input" type="password" id="repassword" placeholder="再次输入新密码">
                    <span class="icon is-small is-left"><i class="fa-solid fa-lock"></i></span>
                </div>
            </div>
        </section>
        <footer class="modal-card-foot">
            <div class="buttons">
                <button type="button" class="button is-primary" id="change-pwd-submit">
                    <span class="icon"><i class="fa-solid fa-check"></i></span>
                    <span>确认修改</span>
                </button>
                <button type="button" class="button js-close-change-pwd">取消</button>
            </div>
        </footer>
    </div>
</div>

{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{{ url_for('static', filename='cropperjs-1.6.2/cropper.min.css') }}">
{% endblock %}

{% block extra_scripts %}
<script src="{{ url_for('static', filename='cropperjs-1.6.2/cropper.min.js') }}"></script>
<script>
    $(function () {
        let $modal = $('#edit-modal');

        // 打开编辑模态框
        $('.js-open-edit').on('click', function () {
            $modal.addClass('is-active');
        });

        // 关闭模态框
        $('.js-close-edit, #edit-modal .delete, #edit-modal .modal-background').on('click', function () {
            $modal.removeClass('is-active');
        });

        // ESC 关闭
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && $modal.hasClass('is-active')) {
                $modal.removeClass('is-active');
            }
        });
    });

    // =========================================================
    // 头像上传 & 裁剪
    // =========================================================
    let $cropModal = $('#crop-modal');
    let $fileInput = $('#avatar-file-input');
    let $avatarPreview = $('#edit-avatar-preview');
    let $avatarPlaceholder = $('#edit-avatar-placeholder');
    let $avatarUrlHidden = $('#edit-avatar-url');
    let cropper = null;

    function initCropper(imageUrl) {
        if (cropper) { cropper.destroy(); }
        let $img = $('#crop-image');
        $img.attr('src', imageUrl);
        cropper = new Cropper($img[0], {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            guides: false,
            background: false,
            dragMode: 'move',
            cropBoxMovable: false,
            cropBoxResizable: false,
        });
    }

    function openCropModal(file) {
        let reader = new FileReader();
        reader.onload = function (e) {
            $cropModal.addClass('is-active');
            initCropper(e.target.result);
        };
        reader.readAsDataURL(file);
    }

    function closeCropModal() {
        $cropModal.removeClass('is-active');
        if (cropper) { cropper.destroy(); cropper = null; }
        $fileInput.val('');
    }

    function setAvatarPreview(url) {
        if (url) {
            $avatarPreview.attr('src', url).show();
            $avatarPlaceholder.hide();
            $avatarUrlHidden.val(url);
            $('#btn-clear-avatar').show();
        } else {
            $avatarPreview.attr('src', '').hide();
            $avatarPlaceholder.show();
            $avatarUrlHidden.val('');
            $('#btn-clear-avatar').hide();
        }
    }

    function uploadAvatar(dataUrl) {
        let $confirmBtn = $('#btn-crop-confirm');
        $confirmBtn.prop('disabled', true).addClass('is-loading');

        $.ajax({
            url: '{{ url_for("root.api.upload") }}',
            method: 'POST',
            data: { base64: dataUrl },
            success: function (res) {
                $confirmBtn.prop('disabled', false).removeClass('is-loading');
                if (res.success && res.data && res.data.url) {
                    setAvatarPreview(res.data.url);
                    closeCropModal();
                } else {
                    alert(res.message || '上传失败');
                }
            },
            error: function () {
                $confirmBtn.prop('disabled', false).removeClass('is-loading');
                alert('网络异常，请重试');
            }
        });
    }

    // 触发文件选择
    $('#btn-upload-avatar').on('click', function () {
        $fileInput.trigger('click');
    });

    // 文件选择后打开裁剪
    $fileInput.on('change', function () {
        if (this.files && this.files.length > 0) {
            openCropModal(this.files[0]);
        }
    });

    // 裁剪确认 → 获取结果并上传
    $('#btn-crop-confirm').on('click', function () {
        if (!cropper) return;
        let canvas = cropper.getCroppedCanvas({
            width: 512,
            height: 512,
            imageSmoothingQuality: 'high',
        });
        let dataUrl = canvas.toDataURL('image/jpeg', 0.95);
        uploadAvatar(dataUrl);
    });

    // 裁剪取消
    $('#btn-crop-cancel, #btn-close-crop').on('click', function () {
        closeCropModal();
    });

    // 清除头像
    $('#btn-clear-avatar').on('click', function () {
        setAvatarPreview('');
    });

    // ESC 关闭裁剪框
    $(document).on('keydown', function (e) {
        if (e.key === 'Escape' && $cropModal.hasClass('is-active')) {
            closeCropModal();
        }
    });

    // =========================================================
    // 修改密码
    // =========================================================
    let $pwdModal = $('#change-pwd-modal');
    let $pwdMsg = $('#change-pwd-msg');
    let $pwdSubmit = $('#change-pwd-submit');

    function showPwdMsg(msg, type) {
        let cls = type === 'success' ? 'is-success' : 'is-danger';
        $pwdMsg.removeClass('is-success is-danger').addClass(cls).text(msg).show();
    }

    // 打开修改密码
    $('.js-open-change-pwd').on('click', function () {
        $pwdModal.addClass('is-active');
        $('#new-password').val('');
        $('#repassword').val('');
        $pwdMsg.hide();
        $pwdSubmit.prop('disabled', false);
    });

    // 关闭修改密码
    function closePwdModal() {
        $pwdModal.removeClass('is-active');
    }
    $('.js-close-change-pwd, #change-pwd-modal .delete, #change-pwd-modal .modal-background').on('click', closePwdModal);

    // 提交修改密码
    $pwdSubmit.on('click', function () {
        let newPwd = $('#new-password').val().trim();
        let rePwd = $('#repassword').val().trim();

        if (!newPwd || !rePwd) {
            showPwdMsg('请填写所有密码字段', 'error');
            return;
        }
        if (newPwd.length < 6) {
            showPwdMsg('新密码至少需要6个字符', 'error');
            return;
        }
        if (newPwd !== rePwd) {
            showPwdMsg('两次输入的新密码不一致', 'error');
            return;
        }

        $pwdSubmit.prop('disabled', true).addClass('is-loading').text('修改中...');

        $.ajax({
            url: '{{ url_for("root.api.change_pwd") }}',
            method: 'POST',
            data: {
                new_password: newPwd,
                repassword: rePwd
            },
            success: function (res) {
                if (!res.success) {
                    showPwdMsg(res.message || '修改失败', 'error');
                    $pwdSubmit.prop('disabled', false).removeClass('is-loading').text('确认修改');
                    return;
                }
                showPwdMsg('密码修改成功，即将跳转到登录页...', 'success');
                // 跳转到登出页面（服务端清除 sid cookie）然后重新登录
                setTimeout(function () {
                    window.location.href = '{{ url_for("root.front.signout") }}';
                }, 1500);
            },
            error: function () {
                showPwdMsg('网络异常，请重试', 'error');
                $pwdSubmit.prop('disabled', false).removeClass('is-loading').text('确认修改');
            }
        });
    });

    // ESC 关闭密码弹窗
    $(document).on('keydown', function (e) {
        if (e.key === 'Escape' && $pwdModal.hasClass('is-active')) {
            closePwdModal();
        }
    });

    // =========================================================
    // 绑定 / 解绑账号
    // =========================================================
    let $vcModal = $('#account-vcode-modal');
    let $vcMsg = $('#vcode-msg');
    let $vcSendBtn = $('#vcode-send-btn');
    let $vcConfirmBtn = $('#vcode-confirm-btn');
    let $vcResendBtn = $('#vcode-resend-btn');
    let $vcResendText = $('#vcode-resend-text');
    let $vcBackBtn = $('#vcode-back-btn');
    let $vcStepAccount = $('#vcode-step-account');
    let $vcStepCode = $('#vcode-step-code');
    let vcMode = '';       // 'bind' 或 'unbind'
    let vcAccount = '';
    let vcCountdown = null;

    function escHtml(s) {
        return $('<div>').text(s).html();
    }

    function showVcMsg(msg, type) {
        let cls = type === 'success' ? 'is-success' : 'is-danger';
        $vcMsg.removeClass('is-success is-danger').addClass(cls).text(msg).show();
    }

    function clearVcMsg() {
        $vcMsg.hide();
    }

    function closeVcModal() {
        $vcModal.removeClass('is-active');
    }

    function resetVcUI(toAccountStep) {
        clearVcMsg();
        if (vcCountdown) { clearTimeout(vcCountdown); vcCountdown = null; }
        $vcResendBtn.prop('disabled', true);
        $vcResendText.text('重新发送');
        $vcSendBtn.prop('disabled', false).find('span').text('获取验证码');
        $vcConfirmBtn.prop('disabled', false).find('span').text('确认');
        $('#vcode-input').val('');
        $('#vcode-pwd-input').val('');
        $('#vcode-pwd-row').hide();
        if (toAccountStep) {
            $vcStepAccount.show();
            $vcStepCode.hide();
            $('#vcode-account-input').val('').prop('readonly', false);
            vcAccount = '';
        }
    }

    // 打开绑定弹窗
    function openBind() {
        resetVcUI(true);
        vcMode = 'bind';
        $('#vcode-modal-icon').attr('class', 'fa-solid fa-plus');
        $('#vcode-modal-title').text('绑定邮箱 / 手机号');
        $('#vcode-account-label').text('邮箱 / 手机号');
        $('#vcode-account-input').attr('placeholder', '请输入要绑定的邮箱或手机号');
        $vcModal.addClass('is-active');
    }

    // 打开解绑弹窗
    function openUnbind(account) {
        resetVcUI(true);
        vcMode = 'unbind';
        vcAccount = account;
        $('#vcode-modal-icon').attr('class', 'fa-solid fa-link-slash has-text-danger');
        $('#vcode-modal-title').text('解绑账号');
        $('#vcode-account-label').text('待解绑账号');
        $('#vcode-account-input').val(account).prop('readonly', true);
        $('#vcode-account-input').attr('placeholder', '');
        $('#vcode-pwd-row').show();
        $vcSendBtn.find('span').text('确认解绑');
        $vcModal.addClass('is-active');
    }

    // 事件绑定
    $('.js-open-bind').on('click', openBind);

    $(document).on('click', '.js-open-unbind', function () {
        let account = $(this).data('account');
        openUnbind(account);
    });

    // 关闭操作
    $('.js-close-vcode, #account-vcode-modal .delete, #account-vcode-modal .modal-background').on('click', function () {
        closeVcModal();
        resetVcUI(true);
    });

    $(document).on('click', '.js-close-vcode', function () {
        closeVcModal();
        resetVcUI(true);
    });

    // 发送验证码（绑定）/ 确认解绑（输入密码后直接提交）
    $vcSendBtn.on('click', function () {
        clearVcMsg();
        let account;
        if (vcMode === 'unbind') {
            account = vcAccount;
        } else {
            account = $('#vcode-account-input').val().trim();
        }

        if (!account) {
            showVcMsg('请输入邮箱或手机号', 'error');
            return;
        }

        // 解绑：直接提交密码
        if (vcMode === 'unbind') {
            let password = $('#vcode-pwd-input').val().trim();
            if (!password) {
                showVcMsg('请输入当前密码', 'error');
                return;
            }
            $vcSendBtn.prop('disabled', true).find('span').text('解绑中...');

            $.ajax({
                url: '{{ url_for("root.api.user_unbind_account") }}',
                method: 'POST',
                data: { account: account, password: password },
                success: function (res) {
                    if (!res.success) {
                        showVcMsg(res.message || '解绑失败', 'error');
                        $vcSendBtn.prop('disabled', false).find('span').text('确认解绑');
                        return;
                    }
                    showVcMsg('解绑成功', 'success');
                    setTimeout(function () { window.location.reload(); }, 1000);
                },
                error: function () {
                    showVcMsg('网络异常，请重试', 'error');
                    $vcSendBtn.prop('disabled', false).find('span').text('确认解绑');
                }
            });
            return;
        }

        // 绑定：发送验证码
        let url = '{{ url_for("root.api.user_send_bind_vcode") }}';

        $vcSendBtn.prop('disabled', true).find('span').text('发送中...');

        $.ajax({
            url: '{{ url_for("root.api.user_send_bind_vcode") }}',
            method: 'POST',
            data: { account: account },
            success: function (res) {
                if (!res.success) {
                    showVcMsg(res.message || '发送失败', 'error');
                    $vcSendBtn.prop('disabled', false).find('span').text('获取验证码');
                    return;
                }
                vcAccount = account;
                showVcMsg('验证码已发送', 'success');
                $vcStepAccount.hide();
                $('#vcode-sent-to').text('验证码已发送至 ' + escHtml(account));
                $vcStepCode.show();
                $('#vcode-input').focus();
                // 倒计时 60 秒重新发送
                startResendCountdown();
            },
            error: function () {
                showVcMsg('网络异常，请重试', 'error');
                $vcSendBtn.prop('disabled', false).find('span').text('获取验证码');
            }
        });
    });

    // 倒计时
    function startResendCountdown() {
        let left = 60;
        $vcResendBtn.prop('disabled', true);
        function tick() {
            if (left <= 0) {
                $vcResendBtn.prop('disabled', false);
                $vcResendText.text('重新发送');
                return;
            }
            $vcResendText.text('重新发送（' + left + 's）');
            left--;
            vcCountdown = setTimeout(tick, 1000);
        }
        tick();
    }

    // 重新发送（仅绑定模式使用）
    $vcResendBtn.on('click', function () {
        clearVcMsg();

        $.ajax({
            url: '{{ url_for("root.api.user_send_bind_vcode") }}',
            method: 'POST',
            data: { account: vcAccount },
            success: function (res) {
                if (!res.success) {
                    showVcMsg(res.message || '发送失败', 'error');
                    return;
                }
                showVcMsg('验证码已重新发送', 'success');
                startResendCountdown();
            },
            error: function () {
                showVcMsg('网络异常', 'error');
            }
        });
    });

    // 返回修改账号
    $vcBackBtn.on('click', function () {
        resetVcUI(true);
    });

    // 确认：验证并绑定
    $vcConfirmBtn.on('click', function () {
        clearVcMsg();
        let code = $('#vcode-input').val().trim();
        if (!code || code.length !== 6) {
            showVcMsg('请输入 6 位数字验证码', 'error');
            return;
        }

        $vcConfirmBtn.prop('disabled', true).find('span').text('验证中...');

        $.ajax({
            url: '{{ url_for("root.api.user_bind_account") }}',
            method: 'POST',
            data: { account: vcAccount, code: code },
            success: function (res) {
                if (!res.success) {
                    showVcMsg(res.message || '验证失败', 'error');
                    $vcConfirmBtn.prop('disabled', false).find('span').text('确认');
                    return;
                }
                showVcMsg('绑定成功', 'success');
                // 刷新页面
                setTimeout(function () { window.location.reload(); }, 1000);
            },
            error: function () {
                showVcMsg('网络异常，请重试', 'error');
                $vcConfirmBtn.prop('disabled', false).find('span').text('确认');
            }
        });
    });

    // ESC 关闭验证码弹窗
    $(document).on('keydown', function (e) {
        if (e.key === 'Escape' && $vcModal.hasClass('is-active')) {
            closeVcModal();
            resetVcUI(true);
        }
    });

    // 密码输入框 Enter 提交解绑
    $('#vcode-pwd-input').on('keydown', function (e) {
        if (e.key === 'Enter' && vcMode === 'unbind') {
            $vcSendBtn.trigger('click');
        }
    });

    // =========================================================
    // Passkey 管理
    // =========================================================
    {% if g.passkey_enabled %}
    var $passkeySection = $('#passkey-section');
    var $passkeyTbody = $('#passkey-tbody');
    var $passkeyMsg = $('#passkey-msg');
    var $btnAddPasskey = $('#btn-add-passkey');

    function b64urlToBuf(b64) {
      var bin = atob(b64.replace(/-/g, '+').replace(/_/g, '/'));
      var len = bin.length, buf = new ArrayBuffer(len), arr = new Uint8Array(buf);
      for (var i = 0; i < len; i++) arr[i] = bin.charCodeAt(i);
      return buf;
    }
    function bufToB64url(buf) {
      var arr = new Uint8Array(buf), bin = '';
      for (var i = 0; i < arr.byteLength; i++) bin += String.fromCharCode(arr[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function showPasskeyMsg(msg, type) {
        var cls = 'notification is-' + (type === 'success' ? 'success' : 'danger') + ' is-light';
        $passkeyMsg.attr('class', cls).text(msg).show();
        setTimeout(function () { $passkeyMsg.fadeOut(); }, 6000);
    }

    function renderCredentials(list) {
        $passkeyTbody.empty();
        if (!list || list.length === 0) {
            $passkeyTbody.append('<tr id="passkey-empty-row"><td colspan="4" class="has-text-centered has-text-grey">暂无绑定的 Passkey 设备</td></tr>');
            return;
        }
        for (var i = 0; i < list.length; i++) {
            var c = list[i];
            var name = c.device_name || '未知设备';
            var ctime = c.ctime ? formatTimestamp(c.ctime) : '—';
            var lastUsed = c.last_used_at ? formatTimestamp(c.last_used_at) : '—';
            var row = '<tr data-credential-id="' + c.credential_id + '">' +
                '<td><span class="is-size-7 has-text-weight-medium">' + $('<div>').text(name).html() + '</span></td>' +
                '<td class="is-size-7">' + ctime + '</td>' +
                '<td class="is-size-7">' + lastUsed + '</td>' +
                '<td><button class="button is-danger is-light is-small btn-del-passkey" data-credential-id="' + c.credential_id + '">' +
                '<span>删除</span></button></td></tr>';
            $passkeyTbody.append(row);
        }
    }

    function loadCredentials() {
        $.ajax({
            url: '{{ url_for("root.api.passkey_list_credentials") }}',
            method: 'GET',
            dataType: 'json',
            success: function (res) {
                if (res.success && res.data) {
                    renderCredentials(res.data.credentials || res.data);
                }
            }
        });
    }

    // 页面加载时直接获取已绑定列表
    loadCredentials();

    // 绑定 Passkey
    $btnAddPasskey.on('click', function () {
        $btnAddPasskey.prop('disabled', true).addClass('is-loading');

        $.ajax({
            url: '{{ url_for("root.api.passkey_register_options") }}',
            method: 'POST',
            dataType: 'json',
            success: function (res) {
                if (!res.success || !res.data) {
                    showPasskeyMsg(res.message || '获取注册选项失败', 'error');
                    $btnAddPasskey.prop('disabled', false).removeClass('is-loading');
                    return;
                }
                var opts = res.data;
                opts.challenge = b64urlToBuf(opts.challenge);
                opts.user.id = b64urlToBuf(opts.user.id);
                if (opts.excludeCredentials) {
                    opts.excludeCredentials = opts.excludeCredentials.map(function (c) {
                        c.id = b64urlToBuf(c.id);
                        return c;
                    });
                }

                navigator.credentials.create({ publicKey: opts }).then(function (cred) {
                    var json = {
                        id: cred.id,
                        rawId: bufToB64url(cred.rawId),
                        type: cred.type,
                        response: {
                            clientDataJSON: bufToB64url(cred.response.clientDataJSON),
                            attestationObject: bufToB64url(cred.response.attestationObject)
                        }
                    };
                    return $.ajax({
                        url: '{{ url_for("root.api.passkey_register_verify") }}',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(json),
                        dataType: 'json'
                    });
                }).then(function (vres) {
                    $btnAddPasskey.prop('disabled', false).removeClass('is-loading');
                    if (vres.success) {
                        showPasskeyMsg('Passkey 绑定成功', 'success');
                        loadCredentials();
                    } else {
                        showPasskeyMsg(vres.message || '验证失败', 'error');
                    }
                }).catch(function (err) {
                    $btnAddPasskey.prop('disabled', false).removeClass('is-loading');
                    if (err.name !== 'NotAllowedError') {
                        showPasskeyMsg('绑定失败：' + (err.message || '请重试'), 'error');
                    }
                });
            },
            error: function (xhr) {
                var msg = '服务请求失败';
                try { var r = JSON.parse(xhr.responseText); msg = r.message || msg; } catch (e) {}
                showPasskeyMsg(msg, 'error');
                $btnAddPasskey.prop('disabled', false).removeClass('is-loading');
            }
        });
    });

    // 删除 Passkey
    $(document).on('click', '.btn-del-passkey', function () {
        var credId = $(this).data('credential-id');
        var $btn = $(this);
        if (!confirm('确定要删除这个 Passkey 设备吗？')) return;
        $btn.prop('disabled', true).addClass('is-loading');

        $.ajax({
            url: '{{ url_for("root.api.passkey_delete_credential", credential_id="CRED_ID") }}'.replace('CRED_ID', encodeURIComponent(credId)),
            method: 'DELETE',
            dataType: 'json',
            success: function (res) {
                if (res.success) {
                    showPasskeyMsg('已删除', 'success');
                    loadCredentials();
                } else {
                    showPasskeyMsg(res.message || '删除失败', 'error');
                    $btn.prop('disabled', false).removeClass('is-loading');
                }
            },
            error: function () {
                showPasskeyMsg('删除失败，请重试', 'error');
                $btn.prop('disabled', false).removeClass('is-loading');
            }
        });
    });
</script>
{% endblock %}