{% extends "layout.j2" %}
{% block title %}注册 - {{ config.get("SITE_TITLE") or "Passport" }}{% endblock %}

{% block content %}
<div class="page-center">
    <div class="auth-card">
        <div class="card">
            <header class="card-header">
                <p class="card-header-title">创建账号</p>
            </header>
            <div class="card-content">
                {% if error %}
                <div class="notification is-danger is-light mb-4">
                    <button class="delete"></button>
                    {{ error }}
                </div>
                {% endif %}

                <!-- 注册方式 Tab -->
                <div class="tabs is-toggle is-fullwidth mb-4" id="signup-tabs">
                    <ul>
                        <li class="is-active" id="tab-username" data-tab="username">
                            <a><span class="icon"><i class="fa-solid fa-user"></i></span>
                                <span>用户名注册</span></a>
                        </li>
                        <li id="tab-vcode" data-tab="vcode">
                            <a><span class="icon"><i class="fa-solid fa-envelope"></i></span>
                                <span>邮箱/手机号注册</span></a>
                        </li>
                    </ul>
                </div>

                <form method="post" action="{{ url_for('root.front.signup') }}" id="signup-form">
                    <input type="hidden" name="encrypted_password" id="encrypted-password">
                    <input type="hidden" name="encrypted_repassword" id="encrypted-repassword">
                    <div class="field">
                        <label class="label">账号</label>
                        <div class="control has-icons-left">
                            <input class="input" type="text" name="account" id="signup-account"
                                placeholder="用户名（6位以上）"
                                value="{{ account or '' }}" required autocomplete="username">
                            <span class="icon is-small is-left">
                                <i class="fa-solid fa-user"></i>
                            </span>
                        </div>
                        <p class="help" id="account-hint">支持字母、数字、下划线，6位以上</p>
                    </div>

                    <!-- 验证码区域（邮箱/手机号注册时显示） -->
                    <div id="vcode-section" style="display:none;">
                        <div class="field is-grouped">
                            <div class="control is-expanded">
                                <label class="label">验证码</label>
                                <input class="input" type="text" name="vcode" id="signup-vcode"
                                    placeholder="6 位数字验证码" maxlength="6" autocomplete="off">
                            </div>
                            <div class="control" style="padding-top: 2rem;">
                                <button class="button is-primary is-outlined" id="btn-send-signup-vcode"
                                    type="button">
                                    <span>获取验证码</span>
                                </button>
                            </div>
                        </div>
                        <p class="help" id="vcode-hint"></p>
                    </div>

                    <div class="field">
                        <label class="label">密码</label>
                        <div class="control has-icons-left">
                            <input class="input" type="password" name="password" placeholder="至少 6 位密码" required
                                autocomplete="new-password">
                            <span class="icon is-small is-left">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">确认密码</label>
                        <div class="control has-icons-left">
                            <input class="input" type="password" name="repassword" placeholder="再次输入密码" required
                                autocomplete="new-password">
                            <span class="icon is-small is-left">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                        </div>
                    </div>

                    {% if g.geetest_enabled %}
                    <input type="hidden" name="geetest_challenge" id="geetest-challenge">
                    <input type="hidden" name="geetest_validate" id="geetest-validate">
                    <input type="hidden" name="geetest_seccode" id="geetest-seccode">
                    <div class="field" id="geetest-field">
                        <div id="geetest-captcha"></div>
                        <p class="help is-success" id="geetest-ok" style="display:none">验证通过，请点击「注 册」</p>
                        <p class="help is-danger" id="geetest-error" style="display:none">请先完成行为验证</p>
                    </div>
                    {% endif %}

                    <div class="field mt-4">
                        <button class="button is-light is-fullwidth" type="submit" id="btn-submit-signup">
                            <strong>注 册</strong>
                        </button>
                    </div>
                </form>

                <div class="has-text-centered mt-5">
                    <p class="is-size-7 has-text-grey">
                        已有账号？
                        <a href="{{ url_for('root.front.signin') }}" class="has-text-primary">立即登录</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script src="{{ url_for('static', filename='js/password-encrypt.js') }}"></script>
{% if g.geetest_enabled %}
<script src="{{ url_for('static', filename='js/gt.0.5.0.js') }}"></script>
{% endif %}
<script>
$(function () {
    let $tabUsername = $('#tab-username');
    let $tabVcode = $('#tab-vcode');
    let $vcodeSection = $('#vcode-section');
    let $accountInput = $('#signup-account');
    let $accountHint = $('#account-hint');
    let $vcodeHint = $('#vcode-hint');
    let $vcodeInput = $('#signup-vcode');
    let $btnSendVcode = $('#btn-send-signup-vcode');
    let $btnSubmit = $('#btn-submit-signup');

    let currentTab = 'username';
    let sendTimer = null;
    let sendCountdown = 0;
    let geetestLoading = false;
    let geetestVerified = false;

    // Tab 切换
    $('#signup-tabs li a').on('click', function (e) {
        e.preventDefault();
        let tab = $(this).parent().data('tab');

        if (tab === 'username') {
            $tabUsername.addClass('is-active');
            $tabVcode.removeClass('is-active');
            $vcodeSection.hide();
            $vcodeInput.removeAttr('required');
            $accountInput.attr('placeholder', '用户名（6位以上）');
            $accountHint.text('支持字母、数字、下划线，6位以上');
            currentTab = 'username';
        } else {
            $tabVcode.addClass('is-active');
            $tabUsername.removeClass('is-active');
            $vcodeSection.show();
            $vcodeInput.attr('required', 'required');
            $accountInput.attr('placeholder', '邮箱 / 手机号');
            $accountHint.text('输入邮箱或手机号，获取验证码后完成注册');
            currentTab = 'vcode';
        }

        $vcodeHint.text('').removeClass('has-text-danger has-text-success');
        $accountInput.val('').focus();
        $vcodeInput.val('');
        clearSendCountdown();
    });

    // 发送注册验证码
    $btnSendVcode.on('click', function () {
        let account = $accountInput.val().trim();
        if (!account) {
            $vcodeHint.text('请先输入邮箱或手机号').addClass('has-text-danger').removeClass('has-text-success');
            return;
        }

        $btnSendVcode.prop('disabled', true).addClass('is-loading');
        $vcodeHint.text('正在发送...').removeClass('has-text-danger has-text-success');

        $.ajax({
            url: '{{ url_for("root.api.send_signup_vcode") }}',
            method: 'POST',
            data: { account: account },
            success: function (res) {
                if (res.success) {
                    $vcodeHint.text('验证码已发送，请查收').addClass('has-text-success').removeClass('has-text-danger');
                    $btnSendVcode.removeClass('is-loading');
                    startCountdown();
                } else {
                    $vcodeHint.text(apiMessage(res, '发送失败')).addClass('has-text-danger').removeClass('has-text-success');
                    $btnSendVcode.prop('disabled', false).removeClass('is-loading');
                }
            },
            error: function () {
                $vcodeHint.text('网络错误，请稍后重试').addClass('has-text-danger').removeClass('has-text-success');
                $btnSendVcode.prop('disabled', false).removeClass('is-loading');
            }
        });
    });

    // 发送倒计时
    function startCountdown() {
        sendCountdown = 60;
        updateSendBtn();
        sendTimer = setInterval(function () {
            sendCountdown--;
            if (sendCountdown <= 0) {
                clearSendCountdown();
            } else {
                updateSendBtn();
            }
        }, 1000);
    }

    function clearSendCountdown() {
        if (sendTimer) {
            clearInterval(sendTimer);
            sendTimer = null;
        }
        sendCountdown = 0;
        $btnSendVcode.prop('disabled', false).find('span').text('获取验证码');
    }

    function updateSendBtn() {
        $btnSendVcode.find('span').text(sendCountdown + '秒后重试');
    }

    // 表单提交：加密密码后传输（JWE），避免明文密码暴露
    $('#signup-form').on('submit', function (e) {
        {% if g.geetest_enabled %}
        if (geetestLoading) {
            // 验证码仍在初始化，提示并定位到验证码行
            $('#geetest-error').text('行为验证加载中，请稍候').show();
            $('#geetest-field').get(0).scrollIntoView({behavior: 'smooth', block: 'center'});
            return false;
        }
        if (!geetestVerified) {
            // 未完成行为验证，提示并定位到验证码行
            $('#geetest-error').text('请先完成行为验证').show();
            $('#geetest-field').get(0).scrollIntoView({behavior: 'smooth', block: 'center'});
            return false;
        }
        {% endif %}
        let account = $accountInput.val().trim();
        let $pwd = $(this).find('input[name="password"]');
        let $rePwd = $(this).find('input[name="repassword"]');
        let password = $pwd.val();
        let repassword = $rePwd.val();

        if (currentTab === 'vcode') {
            let vcode = $vcodeInput.val().trim();
            if (!account || !vcode) {
                return true; // 交给后端校验
            }
        }
        if (!password || !repassword) {
            return true; // 空密码交给后端校验
        }
        // 浏览器不支持 WebCrypto（非 HTTPS / 老浏览器）时降级为明文提交
        if (!window.crypto || !window.crypto.subtle) {
            return true;
        }
        e.preventDefault();
        $btnSubmit.prop('disabled', true).addClass('is-loading').find('strong').text('注册中...');

        let $form = $(this);
        Promise.all([
            PassportEncrypt.encryptPassword(password),
            PassportEncrypt.encryptPassword(repassword)
        ]).then(function (results) {
            $form.find('input[name="encrypted_password"]').val(results[0]);
            $form.find('input[name="encrypted_repassword"]').val(results[1]);
            $pwd.val('');
            $rePwd.val('');
            $form[0].submit(); // 原生提交，不再触发本处理器
        }).catch(function () {
            $btnSubmit.prop('disabled', false).removeClass('is-loading').find('strong').text('注 册');
            alert('密码加密失败，请重试');
        });
    });

    {% if g.geetest_enabled %}
    // GeeTest 行为验证初始化（弹窗模式：显示"点击验证"按钮，点击后弹出验证码）
    $.ajax({
        url: '{{ url_for("root.api.geetest_register") }}?t=' + (new Date()).getTime(),
        method: 'GET',
        dataType: 'json',
        success: function (res) {
            geetestLoading = false;
            // 服务端返回裸 JSON：{success, gt, challenge, new_captcha}
            if (!res || !res.gt || !res.challenge) {
                return;
            }
            // 配置参数来自服务端 SDK（参考官方 Web 部署文档）
            initGeetest({
                gt: res.gt,
                challenge: res.challenge,
                offline: res.success !== 1,
                new_captcha: true,
                https: true,
                product: 'popup'
            }, function (captchaObj) {
                // 在 #geetest-captcha 容器内渲染"点击验证"按钮
                captchaObj.appendTo('#geetest-captcha');
                captchaObj.onSuccess(function () {
                    let result = captchaObj.getValidate();
                    $('#geetest-challenge').val(result.geetest_challenge);
                    $('#geetest-validate').val(result.geetest_validate);
                    $('#geetest-seccode').val(result.geetest_seccode);
                    geetestVerified = true;
                    // 无感验证：一点即过，不自动提交表单，由用户点击「注 册」提交
                    $('#geetest-error').hide();
                    $('#geetest-captcha').hide();
                    $('#geetest-ok').show();
                });
            });
        },
        error: function () {
            geetestLoading = false;
        }
    });
    {% endif %}
});
</script>
{% endblock %}