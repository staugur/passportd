{% extends "layout.j2" %}
{% block title %}我的授权 - Passport{% endblock %}

{% block content %}
<section class="section">
  <div class="container" style="max-width: 900px;">

    {# 页头 #}
    <div class="mb-5">
      <h1 class="title is-4 mb-1">
        <span class="icon-text">
          <span class="icon"><i class="fa-solid fa-check-to-slot"></i></span>
          <span>我的授权</span>
        </span>
      </h1>
      <p class="subtitle is-6 has-text-grey mb-0">管理你已授权的 OIDC 客户端应用</p>
    </div>

    {# 加载/错误提示 #}
    <div id="loading-notice" class="has-text-centered py-6 is-hidden">
      <span class="icon is-large has-text-grey-light"><i class="fa-solid fa-spinner fa-pulse fa-2x"></i></span>
      <p class="has-text-grey mt-2">加载中...</p>
    </div>

    <div id="error-notice" class="notification is-danger is-light is-hidden">
      <button class="delete"></button>
      <span id="error-msg"></span>
    </div>

    {# 授权列表 #}
    <div id="auth-list"></div>

  </div>
</section>

{# 撤销确认模态框 #}
<div class="modal" id="revoke-modal">
  <div class="modal-background"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">
        <span class="icon-text">
          <span class="icon has-text-danger"><i class="fa-solid fa-triangle-exclamation"></i></span>
          <span>确认撤销授权</span>
        </span>
      </p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <p>确定要撤销对 <strong id="revoke-client-name"></strong> 的授权吗？</p>
      <p class="has-text-grey is-size-7 mt-2">撤销后该应用将无法继续访问你的账号数据，已有的 Access Token 也会同步失效。</p>
    </section>
    <footer class="modal-card-foot">
      <button class="button is-danger" id="confirm-revoke-btn">确认撤销</button>
      <button class="button js-close-revoke">取消</button>
    </footer>
  </div>
</div>

{% endblock %}

{% block extra_scripts %}
<script>
$(function () {
  let $listEl = $('#auth-list');
  let $loadingEl = $('#loading-notice');
  let $errorEl = $('#error-notice');
  let $errorMsgEl = $('#error-msg');
  let $revokeModal = $('#revoke-modal');
  let revokeClientId = null;

  // --- 关闭 error 通知 ---
  $errorEl.find('.delete').on('click', function () {
    $errorEl.addClass('is-hidden');
  });

  // --- 关闭模态框 ---
  function closeModal() {
    $revokeModal.removeClass('is-active');
  }

  $(document).on('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });

  $(document).on('click', '.modal-background, .modal .delete, .js-close-revoke', function () {
    closeModal();
  });

  // --- 撤销 ---
  $('#confirm-revoke-btn').on('click', function () {
    if (!revokeClientId) return;
    let formData = new FormData();
    formData.append('client_id', revokeClientId);

    $.ajax({
      url: '{{ url_for("root.api.user_oauth_authorizations") }}',
      method: 'DELETE',
      data: formData,
      processData: false,
      contentType: false,
      success: function (data) {
        if (data.success) {
          closeModal();
          revokeClientId = null;
          loadAuthorizations();
        } else {
          alert('撤销失败: ' + (data.message || '未知错误'));
        }
      },
      error: function (xhr) {
        alert('网络错误: ' + xhr.statusText);
      }
    });
  });

  // --- 加载授权列表 ---
  function loadAuthorizations() {
    $loadingEl.removeClass('is-hidden');
    $errorEl.addClass('is-hidden');
    $listEl.empty();

    $.ajax({
      url: '{{ url_for("root.api.user_oauth_authorizations") }}',
      method: 'GET',
      success: function (data) {
        $loadingEl.addClass('is-hidden');
        if (!data.success) {
          showError(data.message || '加载失败');
          return;
        }
        let records = data.data || [];
        if (records.length === 0) {
          $listEl.html(
            '<div class="box has-text-centered has-text-grey py-6">' +
            '<span class="icon is-large"><i class="fa-solid fa-shield-halved fa-2x"></i></span>' +
            '<p class="mt-3">暂无已授权的应用</p>' +
            '<p class="is-size-7 mt-1">使用 OIDC 客户端登录后，授权过的应用会出现在这里</p>' +
            '</div>'
          );
          return;
        }
        renderList(records);
      },
      error: function (xhr) {
        $loadingEl.addClass('is-hidden');
        showError('网络错误: ' + xhr.statusText);
      }
    });
  }

  function showError(msg) {
    $errorMsgEl.text(msg);
    $errorEl.removeClass('is-hidden');
  }

  function renderList(records) {
    let html =
      '<div class="table-container">' +
      '<table class="table is-fullwidth is-hoverable">' +
      '<thead><tr>' +
      '<th>应用名称</th>' +
      '<th>Client ID</th>' +
      '<th>授权范围</th>' +
      '<th>授权时间</th>' +
      '<th style="width: 100px;">操作</th>' +
      '</tr></thead><tbody>';

    $.each(records, function (_, r) {
      let name = (r.name) || (r.oidc_client ? r.oidc_client.name : '');
      html += '<tr>' +
        '<td class="has-text-weight-semibold">' + escHtml(name || r.client_id) + '</td>' +
        '<td><code class="is-size-7">' + escHtml(r.client_id) + '</code></td>' +
        '<td>' +
        '<div class="tags">';
      let scopes = (r.scope || 'openid').split(' ');
      $.each(scopes, function (_, s) {
        html += '<span class="tag is-info is-light is-size-7">' + escHtml(s) + '</span>';
      });
      html += '</div></td>' +
        '<td class="is-size-7 has-text-grey">' + formatTimestamp(r.created_at || r.ctime) + '</td>' +
        '<td>' +
        '<button class="button is-danger is-light is-small js-revoke" data-id="' + escHtml(r.client_id) + '" data-name="' + escHtml(name || r.client_id) + '">' +
        '<span class="icon is-small"><i class="fa-solid fa-xmark"></i></span>' +
        '<span>撤销</span>' +
        '</button>' +
        '</td></tr>';
    });

    html += '</tbody></table></div>';
    $listEl.html(html);

    // 事件委托：撤销按钮
    $listEl.on('click', '.js-revoke', function () {
      revokeClientId = $(this).data('id');
      $('#revoke-client-name').text($(this).data('name'));
      $revokeModal.addClass('is-active');
    });
  }

  function escHtml(str) {
    return $('<div>').text(str).html();
  }

  // 初始化
  loadAuthorizations();
});
</script>
{% endblock %}
